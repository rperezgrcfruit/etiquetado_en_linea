# Database Configuration
# NOTE: If DB_PASS contains special chars like # or $, wrap in double quotes
# Example: DB_PASS="daniroro2026$#"
DB_HOST=45.239.108.34
DB_NAME=grcfruit_grc
DB_USER=grcfruit_admin
DB_PASS="your_password_here"
DB_CHARSET=utf8mb4

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=/packing
APP_TIMEZONE=America/Santiago

# Temporada (fruit export season) - leave empty to default to current year
TEMPORADA_ACTUAL=2026

# Domain constants
BIN_TARA=43              # Tara del bin (kg) — usado en cálculos de peso neto
PLANTA_CENTRAL_CSP=121293  # CSP de la planta central (dato de prueba)

# Local DB (internal/LAN, used for ZPL printing)
DB_LOCAL_HOST=192.168.1.50
DB_LOCAL_USER=grc_app
DB_LOCAL_PASS="your_local_password_here"

